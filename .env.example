# SCRAPING API Key (for BWS, ScraperAPI, etc.)
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here

# IP Info Token
IPINFO_TOKEN=ipinfo_token_here

# Bright Data Scraping Browser
BRIGHTDATA_CUSTOMER_ID=your_customer_id
BRIGHTDATA_ZONE=your_zone
BRIGHTDATA_PASSWORD=your_password

# Database Configuration
# Set USE_LOCAL_DB=true for local SQLite development (default: false - uses Supabase)
USE_LOCAL_DB=false

# Supabase PostgreSQL connection string (used when USE_LOCAL_DB=false)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.mjhxcgnkxreakcqubbms.supabase.co:5432/postgres
